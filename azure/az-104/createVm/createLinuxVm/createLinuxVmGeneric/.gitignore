###############################################################################
# Terraform State & Locks
###############################################################################
# Local terraform state (state is stored in Azure Storage)
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
crash.log
*.tfstate.backup

###############################################################################
# Azure Credentials & Secrets (DO NOT COMMIT)
###############################################################################
# Provider configuration with embedded credentials
# NOTE: Use environment variables instead:
#   export ARM_CLIENT_ID="..."
#   export ARM_CLIENT_SECRET="..."
#   export ARM_TENANT_ID="..."
#   export ARM_SUBSCRIPTION_ID="..."
providers-secrets.tf
backend-config.hcl

# Terraform variables with sensitive values
*.tfvars
!terraform.tfvars.example
terraform.tfvars.*.secret

