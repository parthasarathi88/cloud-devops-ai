# Azure Credentials
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# Azure Service Principal credentials
ARM_CLIENT_ID=your-client-id-here
ARM_CLIENT_SECRET=your-client-secret-here
ARM_TENANT_ID=your-tenant-id-here
ARM_SUBSCRIPTION_ID=your-subscription-id-here

# Optional: Azure Storage Backend credentials
ARM_STORAGE_ACCOUNT=your-storage-account-name
ARM_CONTAINER_NAME=tfstate
ARM_RESOURCE_GROUP_NAME=your-resource-group-name
ARM_ACCESS_KEY=your-storage-account-key-here

# Optional: Terraform settings
TF_LOG=INFO
# TF_LOG_PATH=terraform.log
